within HelmholtzMedia.Validation.Properties;
model EoSPropylene "Propylene EoS (Lemmon et al.) against check values computed with CoolProp 8.0.0 (IIR reference state)"
  extends EoSCheck(
    redeclare package Medium = HelmholtzMedia.HelmholtzFluids.Propylene,
    T={100, 250, 300, 365, 400, 570},
    d={757.7, 585.5, 5, 229.6, 250, 2},
    p={10054249.76, 4979299.352, 284364.7632, 4621386.924, 8011474.459, 224433.4828},
    cv={1517.114385, 1417.818205, 1362.764478, 2373.064597, 1955.223138, 2282.986423},
    cp={2139.22394, 2260.406606, 1598.192847, 219522.5298, 5157.661188, 2485.004778},
    w={1979.707185, 1073.200886, 252.7756598, 144.6958675, 227.7472779, 348.8624226},
    h={-162067.226, 148611.7306, 631227.2076, 533288.0473, 606164.2247, 1184521.354},
    s={-1162.721627, 773.8996066, 2701.859676, 1990.975565, 2144.932984, 4032.448171},
    Tsat={100, 150, 225.531, 273.15, 300, 360},
    psat={0.04114547577, 410.9549069, 101325.742, 584090.5474, 1208579.81, 4218671.751},
    dl={754.0186956, 697.6142299, 610.0571279, 546.1263813, 503.0525663, 325.7420503},
    dv={2.082378415e-06, 0.01387291484, 2.358862757, 12.32813683, 25.57196356, 138.1066929},
    hl={-173352.2804, -68747.55514, 90107.38476, 200000, 268692.5142, 473106.4963},
    hv={397159.9765, 446625.3952, 528991.7723, 577590.9764, 599981.4248, 588407.5247},
    sv={4562.566227, 3142.608785, 2508.019567, 2382.357593, 2339.851948, 2149.388888});
  annotation (experiment(StopTime=1), Documentation(info="<html>
<p>The check values were computed with CoolProp 8.0.0 (equation of state of Lemmon et al.), with the IIR reference state.</p>
</html>"));
end EoSPropylene;
