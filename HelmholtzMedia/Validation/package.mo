within HelmholtzMedia;
package Validation "Validation of the algorithms: convergence, robustness, performance, accuracy of values and derivatives"
  extends Modelica.Icons.ExamplesPackage;

  annotation (Documentation(info="<html>
<p>Models that test the implementation: convergence and robustness of the iterative functions, performance, and the
correctness and accuracy of property values and derivatives. For examples of how to use the media in models, see HelmholtzMedia.Examples.</p>
</html>"));
end Validation;
