within HelmholtzMedia;
package Examples "Examples of using the media in fluid models"
  extends Modelica.Icons.ExamplesPackage;

  annotation (Documentation(info="<html>
<p>
Examples of using HelmholtzMedia fluids in fluid system models; all models can be simulated directly.
Models that test the implementation (convergence, robustness, performance, accuracy of values and derivatives)
are located in HelmholtzMedia.Validation.
</p>
</html>"));
end Examples;
